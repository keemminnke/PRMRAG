        <mxCell id="comp3_badge" value="&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Step 3&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#996185;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="481" width="70" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="comp3_title" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;단계별 직접 선호도 최적화 (Step-level DPO)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="430" y="505" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="comp3_detail" value="• Step 단위 손실 함수 계산&lt;br&gt;• 매 추론 단계 최선의 판단 유도&lt;br&gt;• 정책 모델(Policy Model) 최적화" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
