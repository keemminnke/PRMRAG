        </mxCell>
        <mxCell id="comp1_badge" value="&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Step 1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="71" width="70" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="comp1_title" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;생성형 프로세스 보상 모델&lt;br&gt;(Generative PRM)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="445" y="95" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="comp1_detail" value="• Backbone: Qwen2.5-7B&lt;br&gt;• 단계별 정답 유무 판정&lt;br&gt;• 판단 근거(이유) 텍스트 생성&lt;br&gt;• 논리적 타당성 + 문서 일치성 동시 평가" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="435" y="137" width="240" height="80" as="geometry"/>
        </mxCell>

