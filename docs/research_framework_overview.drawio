        <mxCell id="comp2_badge" value="&lt;font color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Step 2&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=none;fontSize=11;" vertex="1" parent="1">
