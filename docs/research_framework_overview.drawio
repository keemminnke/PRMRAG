      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;PRO-Step: Step-level Process Reward Optimization for RAG&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#666666&quot;&gt;다단계 추론 RAG 시스템의 오류 전파 해결을 위한 단계별 프로세스 보상 최적화 프레임워크&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="900" height="45" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="input_box" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Input&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Multi-hop Question + Retrieved Documents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== Arrow: Input → Step 1 ===== -->
        <mxCell id="arr_input_to_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2.5;strokeColor=#d6b656;fillColor=#fff2cc;" edge="1" source="input_box" target="comp1_box" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr_input_to_s1_label" value="&lt;font style=&quot;font-size:10px; color:#888888&quot;&gt;❶ 추론 과정을&lt;br&gt;단계별로 평가&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="72" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- Component 1: Generative PRM -->
